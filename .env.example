# TeleBlock environment template — copy to .env (and infra/.env) and fill in.
# Never commit real secrets; .env is gitignored.

# --- Chain / RPC ---
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=https://mainnet.base.org
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
ETHERSCAN_API_KEY=

# --- Deployed contract addresses (set after `forge script Deploy`) ---
IDENTITY_REGISTRY_ADDRESS=
GROUP_MANAGER_ADDRESS=
FORUM_MANAGER_ADDRESS=
REPUTATION_ADDRESS=

# --- Indexer ---
RPC_URL=https://sepolia.base.org
START_BLOCK=0
PORT=8090
DATABASE_URL=postgres://teleblock:teleblock@localhost:5432/indexer

# --- Search ---
MEILI_MASTER_KEY=devkey-change-me
MEILI_URL=http://localhost:7700
